    {
      "@id": "/api/data/01a1de6f-c11e-73e1-a678-43fbdcb32247",
      "@type": "Datum",
      "id": "01a1de6f-c11e-73e1-a678-43fbdcb32247",
      "item": "/api/items/01a1de6f-bff4-7eb7-8d9f-973b4ac86da8",
      "collection": null,
      "type": "text",
      "label": "Contents",
      "value": "School anthology of German poetry with about 555 numbered poems (pp. 1–892), indexes by number and by poet, biographical notes on the poets, and explanatory notes. Poets include Goethe, Schiller, Uhland, Heine, Eichendorff, Hölderlin, Rückert, Platen, Mörike, Klopstock, Chamisso, Hebel, Storm and others.",
      "position": 10,
      "currency": null,
      "image": null,
      "imageSmallThumbnail": null,
      "imageLargeThumbnail": null,
      "file": null,
      "video": null,
      "originalFilename": null,
      "choiceList": null,
      "owner": "/api/users/01a1de6f-03c6-7568-a2b7-9d7a173d6776",
      "visibility": "public",
      "parentVisibility": "private",
      "finalVisibility": "private",
      "createdAt": "2026-11-15T10:00:28+01:00",
      "updatedAt": null
    },
    {
      "@id": "/api/data/01a1de6f-c122-7816-972e-0a7de2346234",
      "@type": "Datum",
      "id": "01a1de6f-c122-7816-972e-0a7de2346234",
      "item": "/api/items/01a1de6f-bff4-7eb7-8d9f-973b4ac86da8",
      "collection": null,
      "type": "text",
      "label": "Notes",
      "value": "Half binding: grey cloth spine with marbled paper boards; a round label is missing from the front cover. Spine badly damaged: most of the cloth is gone, so the spine lining (scrap printed paper) and the stitching show, and loose strips are peeling off. Pages are browned with foxing. Old pencil marks (+ / −) next to many poem titles in the index of poets, and some underlining in the preface.",
      "position": 11,
      "currency": null,
